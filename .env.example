# Frontend API URLs
# For same-project Vercel deployment, use relative paths
REACT_APP_CHATBOT_API_URL=/api/chat
REACT_APP_PROVIDERS_API_URL=/api/providers
REACT_APP_PROVIDERS_PAGE_SIZE=12

# Backend MongoDB settings (for local API run / Vercel env vars)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=sehri_finder
MONGODB_PROVIDERS_COLLECTION=providers
# For your current cluster values:
# MONGODB_DB_NAME=Sehri
# MONGODB_PROVIDERS_COLLECTION=Providers
