# Frontend API URLs
# For same-project Vercel deployment, use relative paths
REACT_APP_CHATBOT_API_URL=/api/chat
REACT_APP_PROVIDERS_API_URL=/api/providers
REACT_APP_PROVIDER_SUBMISSIONS_API_URL=/api/providers/submissions
REACT_APP_ADMIN_PROVIDER_SUBMISSIONS_API_URL=/api/admin/provider-submissions
REACT_APP_AUTH_API_URL=/api/auth
REACT_APP_SEHRI_REQUESTS_API_URL=/api/sehri-requests
REACT_APP_PROVIDERS_PAGE_SIZE=12
REACT_APP_DONATION_URL=https://www.launchgood.com
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key
# Comma-separated YouTube links or IDs for Ramadan reminder section
REACT_APP_RAMADAN_VIDEO_URLS=https://www.youtube.com/watch?v=M7lc1UVf-VE,https://www.youtube.com/watch?v=ysz5S6PUM-U

# OpenRouter chatbot settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free
OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_APP_NAME=BangaloreSehri

# Backend MongoDB settings (for local API run / Vercel env vars)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=sehri_finder
MONGODB_PROVIDERS_COLLECTION=providers
MONGODB_PROVIDER_SUBMISSIONS_COLLECTION=provider_submissions
MONGODB_USERS_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=auth_sessions
MONGODB_SEHRI_REQUESTS_COLLECTION=sehri_requests
ADMIN_EMAILS=admin@example.com
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_SESSION_DAYS=7
# For your current cluster values:
# MONGODB_DB_NAME=Sehri
# MONGODB_PROVIDERS_COLLECTION=Providers
